NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional. Enables AI extraction on the server; heuristic matching still works without it.
AI_GATEWAY_API_KEY=
# Optional paid/domain sending. The free path is Settings → connect your mailbox.
RESEND_API_KEY=
RESEND_FROM=
# Gmail OAuth. Create a Google Cloud OAuth web client and add the callback URL
# https://YOUR_DOMAIN/api/mailbox/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
